# Server Configuration
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/farmconnect

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_SHORTCODE=*384*32021#
# USSD Configuration
USSD_CODE=*347*319#

# SMS
SMS_SENDER_ID=PromisePoints Farms Connect
SUPPORT_PHONE=08163471359

# Security
PIN_SALT_ROUNDS=10
JWT_SECRET=your_jwt_secret_change_in_production

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Dojah Configuration
DOJAH_API_URL=https://api.dojah.io
DOJAH_PUBLIC_KEY=your_dojah_public_key
DOJAH_PRIVATE_KEY=your_dojah_private_key
DOJAH_APP_ID=your_dojah_app_id

# Interest Rates
SAVINGS_INTEREST_RATE=8
LOAN_INTEREST_RATE=10

# Features
ENABLE_ESCROW=false
ENABLE_WEATHER=false
ENABLE_ETRANZACT=false